# Build artifacts
bin/
obj/
*.dll
*.exe
*.pdb
*.user
*.suo
.vs/

# ...but ocaml/bin/ is the OCaml CLI *source* directory, not build output.
# The generic bin/ rule above would otherwise drop the entire CLI from the repo.
!ocaml/bin/
!ocaml/bin/**

# Test output
TestResults/
coverage/
*.coverage
coverage.xml
*.trx

# ...but ocaml/coverage/ is the committed bisect_ppx coverage report, not build output.
!ocaml/coverage/
!ocaml/coverage/**

# Native AOT publish
publish/
out/
artifacts/

# GitHub Actions
.github/workflows/*.local.yml

# Rider/VS settings
.idea/
*.DotSettings.user

# logs
*.log
logs/

# OS junk
Thumbs.db
.DS_Store

# Real-world RPG Maker game files (we never commit user-provided content)
fixtures-real/
games-real/

# Track-0 golden-test fixtures (proprietary RTP/archive content; point
# RPGM_FIXTURES_DIR at a local copy — never commit the archives themselves)
fixtures/
ocaml/fixtures/
ocaml/test/fixtures/
*.rgssad
*.rgss2a
*.rgss3a

# Generated synthetic-game smoke artifacts (held on D:/rpgm-decrypt-tmp, never in repo)
smoke-CLI/

# secrets
*.pfx
*.key
secrets/

# node-style (just in case)
node_modules/

# SonarScanner local working dir (manual analysis runs only; never commit)
.scannerwork/
.sonar/

# Postman client workspace (local tooling, not part of the repo)
.postman/
postman/
